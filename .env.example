# 复制为 .env 后由 start.sh / deploy.sh / dev.sh 自动加载：
#   cp .env.example .env && vi .env
#   ./deploy.sh        # 一键构建 + 重启（重构期最常用，见 README）
#   ./dev.sh           # 开发模式，后端改动热重载
#   ./start.sh         # 只启动，不构建
#
# 说明：
#   1. Spring Boot 不原生识别 .env 文件名，是靠 start.sh 里的 `set -a` 注入为环境变量的。
#      若手动启动，请用：set -a; . ./.env; set +a; java -jar target/jusic-serve.jar
#   2. 变量名必须与 application-prod.yml 里的 ${Xxx} 完全一致（区分大小写）
#   3. 留空表示沿用 yml 中的默认值；注释用 #
#   4. 优先级：命令行参数 > -D 系统属性 > 环境变量 > 配置文件

# ============ 必改：本机裸跑 ============
# 默认值指向 docker 服务名（redis / jusicMusicApi），本机运行必须覆盖
RedisHost=127.0.0.1
MusicApi=http://127.0.0.1

# ============ 权限 ============
# 聊天框输入「root 密码」可提权为管理员
RoleRootPassword=654321
# actuator 等接口的 Basic 认证（shutdown.sh 会用到）
APIUSER=admin
APIPWD=1

# ============ 房间与播放 ============
HouseSize=128                # 房间数上限
IpHouse=128                  # 单 IP 建房上限
RetainRequireKey=false       # 创建「房间永存」是否需要赞赏订单号
                             #   false(默认)=任何部署都能直接建永久房间，适合自建给朋友用
                             #   true=恢复原版「赞赏解锁」：需先调 /house/addRetainKey/{key} 发放订单号
PlaylistSize=23              # 点歌列表长度
MusicExpireTime=1200000      # 歌曲过期时间(ms)
ReTryCount=2                 # 取歌重试次数
VoteRate=0.3                 # 投票切歌比例(0~1)
WyTopUrl=3778678             # 网易热歌榜 ID

# ============ 音源账号（可选，留空则用 yml 默认）============
WyAccount=
WyPassword=
QqUin=1040927107
QqMusicKey=
QqMusicGuid=114514
QqCdnAddr=http://ws.stream.qqmusic.qq.com/
QqRefreshInterval=86000000

# ============ 小程序 / 通知（可选）============
MiniId=
MiniSecrect=
MailFrom=
MailTo=
ServerJUrl=

# 已知问题：application-prod.yml 里 foreverlist_size 写成了 ${$ForeverlistSize:128}
# （多了一个 $），因此下面这行不会生效；要改只能动 yml，或用外部配置文件写
# jusic.foreverlist-size。
# ForeverlistSize=66

# ============ 静态资源位置（一般不用手写）============
# deploy.sh / dev.sh 启动时会自动注入，无需在这里配：
#   StaticLocations=file:<仓库>/webroot/,classpath:/static/
# 指向外部目录后，改前端不用重打 jar（改完跑 ./deploy.sh --web 即可，见 README 第 8 节）。
# 只有「手动 java -jar 启动、又想用外置目录」时才需要自己写下面这行：
# StaticLocations=file:/abs/path/webroot/,classpath:/static/
