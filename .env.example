# ============================================================
# Jusic 点歌房 · Docker Compose 环境变量
#
# 用法：
#   cp .env.example .env
#   vi .env                    # 至少填标了「必改」的项
#   docker compose up -d
#   浏览器打开 http://localhost:8080
#
# ⚠️ 本文件由 docker compose 逐行解析，注释必须单独成行。
#    写成 `HouseSize=128  # 房间数上限` 会把「# 房间数上限」一起当成值传给容器。
#
# 容器地址（RedisHost / MusicApi）不需要在这里配置，
# docker-compose.yml 已固定指向容器网络内的 redis 与 music-api。
# ============================================================


# ==================== 必改 ====================

# 音乐 API 容器使用的 QQ 号。
# 通过 /user/setCookie 灌入 QQ 会员 cookie 时，cookie 里的 uin 必须等于这个值，
# 否则 cookie 不会被登记为全局登录态，VIP 曲目取不到播放地址。
QQ=1040927107

# API 认证密码（actuator 等接口的 Basic 认证，用户名固定为 admin）
APIPWD=1

# 管理员提权密码：聊天框输入「root 这个密码」即可成为管理员
RoleRootPassword=654321

# @管理员 时的微信推送地址（Server 酱）。
# 必须换成自己的，否则消息会发到项目作者的微信。
# 格式：https://sctapi.ftqq.com/<你的SendKey>.send
# 注意域名是 sctapi.ftqq.com；仓库里旧默认值用的 sc.ftqq.com 早已停止服务。
# 留空则关闭这项推送。
ServerJUrl=

# 网易账号名（手机号或邮箱）。
# 它同时是后端 Redis 里网易 cookie 的存储键名：灌完 cookie 后不要随意改，
# 改了就读不到之前保存的登录态，点歌会退回 30 秒试听。
WyAccount=


# ==================== 音源登录态（要听 VIP 完整版就填） ====================

# QQ 音乐会员 cookie：浏览器登录 y.qq.com 后，从「请求头 → Cookie」整行复制粘贴过来。
# 要求其中的 uin 等于上面的 QQ；填了会在启动时自动登记为服务端登录态，容器重建也不丢。
# 留空则沿用 qq-data 数据卷里上一次灌入的登录态。
QqCookie=

# 网易云会员 cookie：浏览器登录 music.163.com 后，从「请求头 → Cookie」整串复制粘贴过来。
# 实际只用到其中的 MUSIC_U，末尾分号可带可不带。填了会在启动时自动灌入。
# 留空则沿用 Redis 里上一次灌入的登录态（键名见上面的 WyAccount）。
WyCookie=

# ⚠️ cookie 值里若出现 $ 字符，必须写成 $$，否则会被 docker compose 当成变量插值吃掉。


# ==================== 按需调整 ====================

# 接口认证用户名
APIUSER=admin

# 房间数上限
HouseSize=128

# 单 IP 建房上限
IpHouse=128

# 点歌列表长度
PlaylistSize=23

# 歌曲链接过期时间（毫秒），过期后会自动重新取链
MusicExpireTime=1200000

# 取歌失败重试次数
ReTryCount=2

# 投票切歌通过率（0~1），默认超过在线人数 30% 生效
VoteRate=0.3

# 网易热歌榜 ID（默认 3778678 为热歌榜）
WyTopUrl=3778678


# ==================== 可选 ====================

# 邮件通知：@管理员 时同时发一封邮件，留空则不发
MailFrom=
MailTo=

# 微信小程序码，不需要就留空
MiniId=
MiniSecrect=
